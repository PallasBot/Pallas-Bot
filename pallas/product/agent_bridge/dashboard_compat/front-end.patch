 import { isElectron } from './runtime'
 
+const DASHBOARD_BASE_PATH = normalizeBasePath(import.meta.env.BASE_URL)
+
+function normalizeBasePath(base: string): string {
+  if (!base || base === '/') return ''
+  if (!base.startsWith('/') || base.startsWith('//') || /[?#]/.test(base)) return ''
+  return `/${base.split('/').filter(Boolean).join('/')}`
+}
+
+export function joinBasePath(base: string, path: string): string {
+  if (/^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(path)) {
+    throw new Error('API paths must not change origin')
+  }
+  const pathname = path.split(/[?#]/, 1)[0]
+  if (
+    pathname.includes('\\') ||
+    pathname.split('/').some((segment) => {
+      try {
+        const decoded = decodeURIComponent(segment)
+        return ['.', '..'].includes(decoded) || /[\\/%]/.test(decoded)
+      } catch {
+        return true
+      }
+    })
+  ) {
+    throw new Error('API paths must not escape the base path')
+  }
+  const normalizedPath = `/${path.replace(/^\/+/, '')}`
+  if (/^(?:https?|wss?):\/\//i.test(base)) {
+    return `${base.replace(/\/+$/, '')}${normalizedPath}`
+  }
+
+  const normalizedBase = normalizeBasePath(base)
+  if (!normalizedBase) return normalizedPath
+  if (normalizedPath === normalizedBase || normalizedPath.startsWith(`${normalizedBase}/`)) {
+    return normalizedPath
+  }
+  return `${normalizedBase}${normalizedPath}`
+}
+
+export function getAppPath(path: string): string {
+  return joinBasePath(DASHBOARD_BASE_PATH, path)
